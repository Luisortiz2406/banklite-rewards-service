NODE_ENV=development
PORT=3012
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://rewards_svc:<DB_PASSWORD_REWARDS>@localhost:5432/rewards_db
JWT_SECRET=
# Escucha transaction.completed para sumar puntos.
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
# Clave interna PROPIA de rewards-service (la aceptan ledger-service y payment-service).
INTERNAL_API_KEY=
LEDGER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3011
ACCOUNT_SERVICE_URL=http://localhost:3002
KYC_SERVICE_URL=http://localhost:3003
# Retos de ahorro (bolsillos y CDT).
SAVINGS_SERVICE_URL=http://localhost:3013
